{
  "name": "android-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "@swasthyaiq/shared": "workspace:*",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "expo-local-authentication": "~58.0.3",
    "expo-build-properties": "~58.0.12"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~5.7.2",
    "jest-expo": "~58.0.14",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --ci"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/*.test.ts",
      "**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@swasthyaiq/shared$": "<rootDir>/../shared/src/index.ts"
    }
  }
}
