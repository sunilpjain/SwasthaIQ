{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK (TypeScript) for the SwasthyaIQ Arihant prototype — ap-south-1",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "synth": "cdk synth --quiet",
    "diff:dev": "cdk diff 'SwasthyaIQ-dev-*'",
    "deploy:account": "cdk deploy SwasthyaIQ-Account",
    "deploy:dev": "cdk deploy 'SwasthyaIQ-dev-*'",
    "deploy:demo": "cdk deploy 'SwasthyaIQ-demo-*'",
    "test": "jest",
    "test:ci": "jest --runInBand"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.173.2",
    "constructs": "^10.4.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "aws-cdk": "^2.173.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.7.2",
    "tsx": "^4.19.2"
  }
}
